{
  "name": "ticketapp-front",
  "version": "0.0.1",
  "description": "Svelte 5 web components for ticketApp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --open /landing.html",
    "build": "vite build",
    "preview": "vite preview",
    "preview:landing": "vite preview --open /landing.html",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text --coverage.reportsDirectory=coverage",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "svelte-chartjs": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
