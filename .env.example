# ticketApp environment file — example template.
# Copy to `.env` and replace placeholders with real values.
# This file IS committed to the repo (it documents the contract);
# the real `.env` is gitignored.
#
# Vars are consumed by:
#   - docker compose (local-environment/docker-ticketApp/docker-compose.yml)
#   - the opencode MCP server for SonarQube (~/.config/opencode/opencode.json)
#   - CI workflows (.github/workflows/ci-*.yml) via GitHub secrets, not this file

# --- PostgreSQL (local docker compose) ---
POSTGRES_DB=ticketAppDb
POSTGRES_USER=ticketAppUser
POSTGRES_PASSWORD=ticketAppPass
POSTGRES_PORT=6432

# --- SonarQube Cloud (opencode MCP server; local .env only) ---
# All three are required — the MCP server refuses to start if any is missing.
# Generate a user token at: https://sonarcloud.io/account/security
# The token is 40-character hex; newer tokens may carry an `sqp_` prefix.
# (The scanner uses a DIFFERENT set of names — SONAR_TOKEN / SONAR_HOST_URL /
# SONAR_ORGANIZATION — supplied as GitHub Actions secrets. See README.md.)
SONARQUBE_TOKEN=replace-with-your-sonarcloud-user-token
SONARQUBE_ORG=replace-with-your-sonarcloud-organization-key
SONARQUBE_URL=https://sonarcloud.io

# --- Google Sign-In (BFF) ---
# OAuth 2.0 Web client id from Google Cloud Console.
# Front reads the same value via front/.env.local as VITE_GOOGLE_CLIENT_ID.
# Placeholders avoid "<" and ">" on purpose: the MCP server sources this
# file with `sh`, where angle brackets are shell redirections and would
# abort the whole file.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com

# --- BFF session signing ---
# HS256 secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
BFF_JWT_SECRET=replace-with-openssl-rand-base64-32

# --- AI extraction (any OpenAI-compatible provider, ADR 0007) ---
# Required for the scheduler to actually run. The BFF refuses to
# bind placeholders at runtime — the operator layer (this file,
# shell env, or application-local.yml) must supply every value.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_COMPLETION_TOKENS=16384

# Optional: extra HTTP headers attached to every provider request.
# Comma-separated `key=value` pairs. Required by some gateways that
# route on a session or tenant header — opencode-go, for example,
# rejects calls without `X-OpenCode-Session` (400 MissingSessionID).
# Empty by default. Values are never logged; treat them as secrets.
# Example:
#   OPENAI_HEADERS=X-OpenCode-Session=ses-abc123
OPENAI_HEADERS=

# Optional: turn on the SDK's HTTP request/response debug logging.
# Emits the wire shape (request line + response status) through SLF4J
# without touching the request bodies. Useful to diagnose gateways
# that reject with empty bodies — default off because the output is
# otherwise chatty.
# OPENAI_DEBUG_HTTP=true
OPENAI_DEBUG_HTTP=false

# BFF-owned scheduler knobs (application.yml does not bake defaults
# for these either — supply them here, in shell env, or via the
# active profile).
TICKETAPP_AI_ENABLED=true
# Quoted on purpose: unquoted, the shell that sources this file for the
# MCP server globs the spaces and tries to run `*/15` as a command.
# Docker Compose's env_file parser strips the quotes.
TICKETAPP_AI_CRON='0 */15 * * * *'
TICKETAPP_AI_BATCH_SIZE=5
TICKETAPP_AI_RETRY_ATTEMPTS=2

