# CODEOWNERS — automatic review requests.
#
# This file takes owner rules ONLY — never gitignore-style entries.
# Patterns follow gitignore syntax; the LAST matching pattern wins,
# which is why the catch-all `*` sits first.

# Default owner for everything not matched below.
*                                   @arepresas

# Auth, sessions and secrets handling always need a security review.
/bff/src/main/java/com/ticketapp/bff/auth/**    @arepresas
/bff/src/main/java/com/ticketapp/bff/security/** @arepresas

# Schema changes are additive-only and backfills ship separately.
/persistence/src/main/resources/db/**           @arepresas

# Provider port contract (ReceiptExtractor) and its implementations.
/domain/src/main/java/com/ticketapp/domain/ai/** @arepresas
/openai-ai/**                                    @arepresas

# Android client (ADR 0009). The auth folder holds the OAuth
# credential request and the encrypted session token, so it carries the
# same "needs a security reviewer" weight as bff/auth.
/app-android/app/src/main/java/com/ticketapp/android/auth/** @arepresas
# The WebView session hand-off is a security boundary too: it injects
# the token into the page and pins navigation to one origin.
/app-android/app/src/main/java/com/ticketapp/android/web/** @arepresas
/app-android/gradle/libs.versions.toml              @arepresas

# CI, deploy and review automation.
/.github/workflows/**                            @arepresas
/.github/CODEOWNERS                              @arepresas
/.github/ISSUE_TEMPLATE/**                       @arepresas

# Operating manuals for assistants and humans.
/AGENTS.md                                       @arepresas
/CONVENTIONS.md                                  @arepresas
/CONTRIBUTING.md                                 @arepresas
/SECURITY.md                                     @arepresas
